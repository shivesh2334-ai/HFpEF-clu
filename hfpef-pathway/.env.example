# Chatbot LLM configuration — any OpenAI-compatible chat/completions endpoint works.
# Pick ONE provider below, uncomment its two lines, and set LLM_API_KEY to that
# provider's key. Add these as Environment Variables in Vercel (Project Settings →
# Environment Variables), not as a committed .env file.

# --- OpenRouter (many free models, e.g. Llama 3.3 70B :free) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Groq (fast, generous free tier) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- Mistral (free tier) ---
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-small-latest

# --- Google Gemini (OpenAI-compatible endpoint, free tier) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-1.5-flash

LLM_API_KEY=
