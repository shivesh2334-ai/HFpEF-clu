# Chatbot LLM configuration — any OpenAI-compatible chat/completions endpoint works.
# Pick ONE provider below, uncomment its two lines, and set LLM_API_KEY to that
# provider's key. Add these as Environment Variables in Vercel (Project Settings →
# Environment Variables), not as a committed .env file.

# --- OpenRouter (many free models, e.g. Llama 3.3 70B :free) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Groq (fast, generous free tier) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- Mistral (free tier) ---
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-small-latest

# --- Google Gemini (OpenAI-compatible endpoint, free tier) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-1.5-flash

LLM_API_KEY=

# --- Research Portal: Google Sign-In for direct Sheets/Drive access ---
# From a Firebase project (console.firebase.google.com) with the Google sign-in
# provider enabled under Authentication → Sign-in method. These are safe to
# expose client-side (NEXT_PUBLIC_) — Firebase web config is not a secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

