# Chatbot LLM configuration — direct provider APIs.
# Choose one provider:
#   LLM_PROVIDER=groq | gemini | claude
# Set provider-specific key OR set shared fallback LLM_API_KEY.

LLM_PROVIDER=groq

# Shared fallback key (optional if using provider-specific key below)
LLM_API_KEY=

# --- Groq ---
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Gemini ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# --- Claude ---
# CLAUDE_API_KEY=
# CLAUDE_MODEL=claude-3-5-sonnet-latest
